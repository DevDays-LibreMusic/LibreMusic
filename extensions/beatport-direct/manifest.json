{
  "name": "beatport-direct",
  "displayName": "Beatport Direct",
  "version": "0.1.0",
  "description": "Beatport напрямую через свой аккаунт, без внешнего resolver. Экспериментальная версия.",
  "type": [
    "metadata_provider",
    "download_provider"
  ],
  "minAppVersion": "5.3.1",
  "permissions": {
    "network": [
      "api.beatport.com",
      "*.beatport.com",
      "*.cloudfront.net"
    ],
    "storage": false,
    "file": true
  },
  "settings": [
    {
      "key": "token",
      "type": "string",
      "label": "Access token Beatport",
      "secret": true,
      "required": true
    }
  ],
  "qualityOptions": [
    {
      "id": "medium",
      "label": "AAC 128",
      "kind": "lossy"
    },
    {
      "id": "high",
      "label": "AAC 256",
      "kind": "lossy"
    },
    {
      "id": "lossless",
      "label": "FLAC",
      "kind": "lossless"
    }
  ],
  "searchBehavior": {
    "enabled": true,
    "placeholder": "Поиск: Beatport"
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "beatport.com"
    ]
  },
  "capabilities": {
    "downloadFallbackTier": "lossless"
  }
}
