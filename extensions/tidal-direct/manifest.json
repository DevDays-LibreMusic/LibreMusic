{
  "name": "tidal-direct",
  "displayName": "Tidal Direct",
  "version": "0.1.0",
  "description": "Tidal напрямую через свой аккаунт, без внешнего resolver. Экспериментальная версия.",
  "type": [
    "metadata_provider",
    "download_provider"
  ],
  "minAppVersion": "5.3.1",
  "permissions": {
    "network": [
      "api.tidal.com",
      "*.tidal.com",
      "*.tidalhifi.com",
      "*.akamaized.net",
      "*.akamaihd.net",
      "*.cloudfront.net"
    ],
    "storage": false,
    "file": true
  },
  "settings": [
    {
      "key": "token",
      "type": "string",
      "label": "Access token Tidal",
      "secret": true,
      "required": true
    },
    {
      "key": "country",
      "type": "string",
      "label": "Страна аккаунта",
      "default": "US"
    }
  ],
  "qualityOptions": [
    {
      "id": "aac",
      "label": "AAC HIGH",
      "kind": "lossy"
    },
    {
      "id": "flac",
      "label": "FLAC LOSSLESS",
      "kind": "lossless"
    }
  ],
  "searchBehavior": {
    "enabled": true,
    "placeholder": "Поиск: Tidal"
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "tidal.com",
      "listen.tidal.com"
    ]
  },
  "capabilities": {
    "downloadFallbackTier": "lossless"
  }
}
