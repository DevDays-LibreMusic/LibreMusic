{
  "name": "zvuk",
  "displayName": "Звук",
  "version": "0.1.0",
  "description": "Поиск, ссылки, альбомы, плейлисты и загрузка доступного аккаунту аудио. Экспериментальная версия.",
  "type": [
    "metadata_provider",
    "download_provider"
  ],
  "minAppVersion": "5.3.1",
  "permissions": {
    "network": [
      "zvuk.com",
      "*.zvuk.com",
      "*.zvooq.com",
      "*.zvuk.ru"
    ],
    "storage": false,
    "file": true
  },
  "settings": [
    {
      "key": "token",
      "type": "string",
      "label": "Токен Звука (X-Auth-Token)",
      "secret": true,
      "required": true
    }
  ],
  "qualityOptions": [
    {
      "id": "mid",
      "kind": "lossy",
      "label": "MP3 128 kbps"
    },
    {
      "id": "high",
      "kind": "lossy",
      "label": "MP3 320 kbps"
    },
    {
      "id": "flac",
      "kind": "lossless",
      "label": "FLAC"
    }
  ],
  "searchBehavior": {
    "enabled": true,
    "placeholder": "Поиск: Звук"
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "zvuk.com"
    ]
  },
  "capabilities": {
    "downloadFallbackTier": "low_res"
  }
}
